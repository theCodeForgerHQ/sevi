# Sevi configuration: names and non-secret defaults only. Never put real secrets in this file.
# Generated from src/sevi/app/settings.py by `uv run python scripts/gen_env_example.py`
# (test U-CFG-01 checks they agree). Secrets are injected at runtime by Infisical (project
# `sevi`): `infisical run --env=dev -- uv run sevi ...`. Plain environment variables work too.
# ---- top
SEVI_ENV=dev
SEVI_DEMO_MODE=false
SEVI_PUBLIC_BASE_URL=http://127.0.0.1:8000
SEVI_PAGES_ORIGIN=http://127.0.0.1:8000
SEVI_BIND_HOST=127.0.0.1
SEVI_BIND_PORT=8000
SEVI_OP_BIND_HOST=127.0.0.1
SEVI_OP_BIND_PORT=8001
SEVI_TRUSTED_PROXIES=127.0.0.1/32,::1/128
SEVI_CLIENT_IP_HEADER=X-Forwarded-For
SEVI_LOG_LEVEL=INFO
SEVI_LOG_DIR=./var/logs
SEVI_LOG_RETENTION_HOURS=72
SEVI_DATA_DIR=./var/data
SEVI_DRAIN_S=30
SEVI_FRIENDS=ALLOWED
SEVI_VOLUNTEER_CALLS=false
# ---- gnani
SEVI_GNANI__KEY_A=
SEVI_GNANI__KEY_B=
SEVI_GNANI__REST_BASE=https://api.vachana.ai
SEVI_GNANI__KEY_A_PERMITS=1
SEVI_GNANI__KEY_B_PERMITS=1
SEVI_GNANI__STREAM_REST_COEXIST=false
# ---- prisma
SEVI_PRISMA__ENABLED=true
SEVI_PRISMA__WS_URL=wss://api.vachana.ai/stt/v3/stream
SEVI_PRISMA__REST_URL=https://api.vachana.ai/stt/v3
SEVI_PRISMA__FORMAT=transcribe
SEVI_PRISMA__HEADER_MODE=both
SEVI_PRISMA__KEYTERMS_ENABLED=true
SEVI_PRISMA__KEYTERMS_HEADERS=keyterms,x-keyterms,x-keywords
SEVI_PRISMA__SEND_ENABLE_ITN=true
SEVI_PRISMA__VAD_THRESHOLD=0.7
SEVI_PRISMA__MIN_SILENCE_MS=800
SEVI_PRISMA__MIN_SPEECH_MS=100
SEVI_PRISMA__MIN_SEGMENT_MS=100
SEVI_PRISMA__IDLE_TIMEOUT_S=900
SEVI_PRISMA__SAMPLE_RATE_HZ=8000
SEVI_PRISMA__CONNECT_TIMEOUT_S=3.0
SEVI_PRISMA__COMMIT_EMITS_PROCESSING=true
SEVI_PRISMA__SEND_WHILE_GATED=true
SEVI_PRISMA__LATE_GRACE_MS=300
SEVI_PRISMA__T_COMMIT_MAX_MS=1200
SEVI_PRISMA__REST_TIMEOUT_S=15.0
# ---- evon
SEVI_EVON__ENABLED=true
SEVI_EVON__BASE_URL=http://127.0.0.1:8080/v1
SEVI_EVON__API_KEY=
SEVI_EVON__MODEL=evon
SEVI_EVON__TIMEOUT_S=6.0
SEVI_EVON__CONNECT_TIMEOUT_S=1.0
SEVI_EVON__MAX_TOKENS_EXPLAIN=256
SEVI_EVON__MAX_TOKENS_REPORT=640
SEVI_EVON__MAX_TOKENS_TRANSLATION=1024
SEVI_EVON__TEMPERATURE=0.6
SEVI_EVON__TOP_P=0.95
SEVI_EVON__REPEAT_PENALTY=1.0
SEVI_EVON__RESPONSE_FORMAT_STYLE=llamacpp
SEVI_EVON__SCHEMA_PATTERN=true
SEVI_EVON__HEALTH_INTERVAL_S=30
SEVI_EVON__MAX_CONCURRENCY=1
SEVI_EVON__BROWSER_DEADLINE_S=10
SEVI_EVON__REPORT_DEADLINE_S=6
# ---- twilio
SEVI_TWILIO__ACCOUNT_SID=
SEVI_TWILIO__AUTH_TOKEN=
SEVI_TWILIO__FROM_NUMBER=
SEVI_TWILIO__VALIDATE_SIGNATURE=true
SEVI_TWILIO__RING_TIMEOUT_S=30
SEVI_TWILIO__TIME_LIMIT_S=600
SEVI_TWILIO__TRIAL_MINUTES_TOTAL=75.0
SEVI_TWILIO__TRIAL_MINUTES_STOP=65.0
SEVI_TWILIO__RECORD_ANSWERS=false
SEVI_TWILIO__VERIFIED_TO_NUMBERS=
SEVI_TWILIO__AUDIO_TTL_S=120
# ---- phone
SEVI_PHONE__ENABLED=false
# ---- browser_voice
SEVI_BROWSER_VOICE__ENABLED=false
# ---- admission
SEVI_ADMISSION__MAX_KEYPAD_SESSIONS=120
SEVI_ADMISSION__VOICE_QUEUE_VISIBLE_MAX=3
SEVI_ADMISSION__PER_IP_KEYPAD_PER_HOUR=20
SEVI_ADMISSION__PER_IP_VOICE_PER_HOUR=3
SEVI_ADMISSION__IP_HASH_KEY=
SEVI_ADMISSION__VOICE_ETA_S=240
SEVI_ADMISSION__WAITING_ROOM_RETRY_S=60
SEVI_ADMISSION__QUEUE_POLL_TIMEOUT_S=30
SEVI_ADMISSION__ADMITTED_CONNECT_TIMEOUT_S=120
SEVI_ADMISSION__ADMITTED_CONNECT_TIMEOUT_KEYPAD_S=20
SEVI_ADMISSION__PRE_START_SOCKETS_PER_IP=2
# ---- capture
SEVI_CAPTURE__T_GUARD_BROWSER_MS=50
SEVI_CAPTURE__T_ANSWER_MS=8000
SEVI_CAPTURE__T_SETTLE_MS=900
SEVI_CAPTURE__SPEECH_MIN_MS=300
SEVI_CAPTURE__SPEECH_DB_ABOVE_FLOOR=12.0
SEVI_CAPTURE__ECHO_HIGH_DB=10.0
SEVI_CAPTURE__D_EST_DEFAULT_BROWSER_MS=150
SEVI_CAPTURE__D_EST_MAX_MS=1500
SEVI_CAPTURE__MARK_TIMEOUT_EXTRA_MS=3000
# ---- session
SEVI_SESSION__T_CONSENT_PHONE_S=10
SEVI_SESSION__T_CONSENT_BROWSER_S=300
SEVI_SESSION__T_START_S=5
SEVI_SESSION__T_RX_IDLE_S=35
SEVI_SESSION__SEND_TIMEOUT_S=5.0
SEVI_SESSION__T_DIAL_S=60
SEVI_SESSION__MAX_S=720
SEVI_SESSION__INSTRUCTION_REPEATS_MAX=2
# ---- result
SEVI_RESULT__BANK_DIR=./stimuli
SEVI_RESULT__FROZEN_BANK_HASHES={}
SEVI_RESULT__ALLOW_UNFROZEN_BANK=false
SEVI_RESULT__NORMS_PATH=./results/norms.json
SEVI_RESULT__ENABLED_LANGS=ta,en
SEVI_RESULT__EXPERIMENTAL_LANGS=en
SEVI_RESULT__HHIE_ENABLED=false
# ---- retention
SEVI_RETENTION__HOURS=72
SEVI_RETENTION__JOB_INTERVAL_S=600
SEVI_RETENTION__TWILIO_DELETE=true
# ---- operator
SEVI_OPERATOR__USERNAME=sevi-op
SEVI_OPERATOR__PASSWORD_SCRYPT=
SEVI_OPERATOR__ALLOWED_CIDRS=100.64.0.0/10,127.0.0.1/32
# ---- allowlist
SEVI_ALLOWLIST__FERNET_KEY=
SEVI_ALLOWLIST__HMAC_KEY=
# ---- ledger
SEVI_LEDGER__CREDITS_PER_STT_S=
SEVI_LEDGER__CREDITS_PER_TTS_CHAR=
SEVI_LEDGER__KEY_A_TOTAL=5000.0
SEVI_LEDGER__KEY_B_TOTAL=5000.0
SEVI_LEDGER__RESERVE_FRAC=0.1
SEVI_LEDGER__KEY_A_CAL_STOP_FRAC=0.55
SEVI_LEDGER__KEY_B_PUBLIC_STOP_SESSIONS=20
SEVI_LEDGER__VOICE_SESSION_CREDITS_EST=
SEVI_LEDGER__BUDGET_CREDITS_PER_KEY=0.0
# ---- cal
