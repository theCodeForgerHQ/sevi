# Sevi configuration: names only. Never put real values in this file or in git.
# Real values are injected at runtime by Infisical (project `sevi`):
#   infisical run --env=dev -- uv run sevi ...
# Plain environment variables work too.

# ---- gnani
SEVI_GNANI__KEY_A=
SEVI_GNANI__KEY_B=

# ---- twilio (trial IVR demo only)
SEVI_TWILIO__ACCOUNT_SID=
SEVI_TWILIO__AUTH_TOKEN=
SEVI_TWILIO__FROM_NUMBER=

# ---- operator
SEVI_OP__TOKEN=

# ---- ledger: hard per-key credit budget; calls are refused once reached
SEVI_LEDGER__BUDGET_CREDITS_PER_KEY=

# ---- tests: set to 1 only to run @pytest.mark.live tests (never in CI)
SEVI_ALLOW_LIVE=0

# ---- kill switches
SEVI_PHONE__ENABLED=false
SEVI_BROWSER_VOICE__ENABLED=false
# Evon on by default; falls back to template text when unavailable
SEVI_EVON__ENABLED=true
